# App
NEXT_PUBLIC_APP_URL=https://teleworker.fun
NODE_ENV=production

# SEO (Google Search Console / Яндекс.Вебмастер)
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Database (Neon / local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/teleagent?schema=public

# Auth (NextAuth v5) — generate: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-min-32-chars
AUTH_URL=https://teleworker.fun

# Admin seed
ADMIN_EMAIL=admin@teleworker.fun
ADMIN_PASSWORD=change-me-strong-password

# Telegram Login Widget + Demo
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername
NEXT_PUBLIC_TELEGRAM_DEMO_LINK=https://t.me/YourDemoBot

# YooKassa (РФ)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# Stripe (международные)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email (восстановление пароля)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@teleworker.fun

# AI providers (для будущего worker-сервиса)
GIGACHAT_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=

# Anti-spam honeypot (optional)
HONEYPOT_FIELD=website
